{
	"name": "plug/plug-templates",
	"description": "Bibliothèque de templates personnalisés pour Elementor (v3 et v4 Atomic).",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4",
		"yahnis-elsts/plugin-update-checker": "^5.6"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.8",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"PlugTemplates\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"PlugTemplates\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"platform": {
			"php": "7.4.33"
		},
		"sort-packages": true,
		"optimize-autoloader": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"templates:validate": "@php bin/validate-templates.php",
		"templates:build": "@php bin/build-manifest.php",
		"templates:check": [
			"@php bin/validate-templates.php",
			"@php bin/build-manifest.php --check"
		]
	}
}
