{
	"name": "plug-templates",
	"version": "0.1.0",
	"private": true,
	"description": "Bibliothèque de templates personnalisés pour Elementor (v3 et v4 Atomic).",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "wp-scripts build",
		"thumbnails": "node bin/build-thumbnails.mjs",
		"start": "wp-scripts start",
		"lint:js": "eslint assets/src",
		"test:e2e": "playwright test -c tests/e2e",
		"i18n:pot": "wp-env run cli --env-cwd=wp-content/plugins/$(basename $PWD) wp i18n make-pot . languages/plug-templates.pot --exclude=node_modules,vendor,assets/build,tests,bin,dist --domain=plug-templates",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop"
	},
	"devDependencies": {
		"@babel/runtime": "7.26.0",
		"@playwright/test": "1.61.1",
		"@wordpress/scripts": "30.7.0",
		"playwright-core": "1.61.1"
	},
	"dependencies": {
		"@wordpress/api-fetch": "8.2.0",
		"@wordpress/components": "45.0.0",
		"@wordpress/dataviews": "22.1.0",
		"@wordpress/element": "10.2.0",
		"@wordpress/i18n": "7.2.0",
		"@wordpress/icons": "21.0.0"
	}
}
