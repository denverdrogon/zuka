{
	"name": "plug-templates",
	"version": "0.1.0",
	"private": true,
	"description": "Bibliothèque de templates personnalisés pour Elementor (v3 et v4 Atomic).",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "wp-scripts build motion=./assets/src/motion/index.js --output-path=assets/build",
		"start": "wp-scripts start motion=./assets/src/motion/index.js --output-path=assets/build",
		"lint:js": "wp-scripts lint-js assets/src",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop"
	},
	"devDependencies": {
		"@babel/runtime": "7.26.0",
		"@wordpress/scripts": "30.7.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "7.14.0",
		"@wordpress/components": "29.0.0",
		"@wordpress/dataviews": "4.10.0",
		"@wordpress/element": "6.14.0",
		"@wordpress/i18n": "5.14.0",
		"@wordpress/icons": "10.14.0"
	}
}
